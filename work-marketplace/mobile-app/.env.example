# ============================================================
# 📱 WORK MARKETPLACE MOBILE APP — ENVIRONMENT VARIABLES
# ============================================================
# In Expo SDK 49+, any variable prefixed with EXPO_PUBLIC_ is 
# bundled and accessible in code via process.env.EXPO_PUBLIC_*

# ----- Backend API Endpoint -----
# Local testing on same Wi-Fi: http://<YOUR_LAN_IP>:8000/api  (e.g., http://192.168.1.15:8000/api)
# Production / Deployed: https://workmarket-backend-api.vercel.app/api
EXPO_PUBLIC_API_URL=http://localhost:8000/api

# ----- App Branding -----
EXPO_PUBLIC_APP_NAME=JobGram

# ----- Razorpay Public Key (Client-side checkout) -----
EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_test_placeholder
